# OCR provider: tesseract (default, offline) or azure
OCR_PROVIDER=tesseract

# Azure Document Intelligence (optional — primary when configured)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Verification settings
STRICT_WARNING=true
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_TIMEOUT_SECONDS=4.0
MAX_UPLOAD_BYTES=10485760
BATCH_CONCURRENCY=6

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# P2+ factory (optional)
USE_FACTORY_GRAPH=false
RAG_ENABLED=false
CHROMA_PERSIST_DIR=./data/chroma
