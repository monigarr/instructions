# OCR provider: tesseract (default, offline) or azure
OCR_PROVIDER=tesseract

# Azure Document Intelligence (optional — primary when configured)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Verification settings
# STRICT_WARNING is reserved: government-warning validation is always exact.
STRICT_WARNING=true
OCR_CONFIDENCE_THRESHOLD=0.55
OCR_TIMEOUT_SECONDS=4.0
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=268435456
MAX_BATCH_FILES=400
MAX_BATCH_MANIFEST_BYTES=2097152
BATCH_CONCURRENCY=6
BATCH_PERSIST=false
BATCH_PERSIST_DIR=./data/batches
LATENCY_WARN_MS=5000
LATENCY_GATE_ENABLED=false
PREPROCESS_IMPERFECT=false

# Logging (JSON lines with trace_id; set LOG_JSON=false for plain text)
LOG_LEVEL=INFO
LOG_JSON=true

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# P2+ factory (optional)
USE_FACTORY_GRAPH=false
RAG_ENABLED=false
CHROMA_PERSIST_DIR=./data/chroma
